### Start Trip
# Requer token de DRIVER (SCOPE_DRIVER) e o motorista precisa ser o dono da van da rota.
# Usar {{authToken}} (admin) aqui retorna 403.
POST {{baseUrl}}/trips/start
Content-Type: application/json
Authorization: Bearer {{authTokenDriver}}

{
  "routeId": "7495648e-a9e1-47cd-abde-96e66c220bfa",
  "latitude": -23.550520,
  "longitude": -46.633308
}
> {%
    client.global.set("tripId", response.body.id);
    console.log("Viagem iniciada: " + response.body.id);
%}

### Finish Trip

PUT {{baseUrl}}/trips/39c248df-902d-47de-910f-30c4b5b8af21/finish
Content-Type: application/json
Authorization: Bearer {{authTokenDriver}}
